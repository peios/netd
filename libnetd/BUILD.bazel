load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("//build:checks.bzl", "host_test", "shared_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ) + ["build.rs"],
)

rust_library(
    name = "libnetd",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:Cargo.toml",
        "//:Cargo.lock",
    ],
    crate_name = "netd_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = [
        "//netd-abi",
        "//netd-core",
        "//vendor:pnp-core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests-binary",
    size = "small",
    crate = ":libnetd",
    tags = ["manual"],
)

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:Cargo.toml",
        "//:Cargo.lock",
    ],
    crate_name = "netd_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libnetd.so.1"],
    version = VERSION,
    deps = [
        "//netd-abi",
        "//netd-core",
        "//vendor:pnp-core",
    ] + all_crate_deps(normal = True),
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"]),
)

exports_files(["exports.txt"])

# Give Bazel's runtime library graph the same filename as the embedded SONAME.
genrule(
    name = "soname",
    srcs = [":shared"],
    outs = ["libnetd.so.1"],
    cmd = "cp $(execpath :shared) $@",
)

genrule(
    name = "linker-name",
    srcs = [":shared"],
    outs = ["libnetd.so"],
    cmd = "cp $(execpath :shared) $@",
)

cc_import(
    name = "binary-link",
    interface_library = ":linker-name",
    shared_library = select({
        "//build:native": None,
        "//build:packaged": None,
        "//conditions:default": ":soname",
    }),
    system_provided = select({
        "//build:native": True,
        "//build:packaged": True,
        "//conditions:default": False,
    }),
)

cc_library(
    name = "link",
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":binary-link",
        "@peios_sdk//:peios",
    ],
)

cc_test(
    name = "c-abi-test-binary",
    size = "small",
    srcs = ["tests/abi.c"],
    copts = ["-UNDEBUG"],
    data = [":soname"],
    env = {"LD_LIBRARY_PATH": "libnetd"},
    tags = ["manual"],
    deps = [":link"],
)

shared_test(
    name = "tests",
    size = "small",
    binary = ":tests-binary",
    libraries = ["@peios_sdk//:library"],
)

shared_test(
    name = "c-abi-test",
    size = "small",
    binary = ":c-abi-test-binary",
    libraries = [
        ":soname",
        "@peios_sdk//:library",
    ],
)

host_test(
    name = "exports-test",
    size = "small",
    command = "python3 tools/check-exports.py libnetd/libnetd_ffi.so libnetd/exports.txt libnetd/include",
    data = [
        "exports.txt",
        ":headers",
        ":shared",
        "//tools:check-exports.py",
    ],
    tags = [
        "external",
        "no-remote",
    ],
)
