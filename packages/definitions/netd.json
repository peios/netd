{
    "side_effects": ["man-db"],
    "package": {
        "name": "dev.peios.netd",
        "description": "Peios network manager for links, addresses, routes, and DHCP",
        "license": "((MIT OR Apache-2.0) AND Unicode-3.0) AND Apache-2.0 AND (Apache-2.0 OR BSD-2-Clause OR MIT) AND (Apache-2.0 OR MIT) AND BSD-3-Clause AND ISC AND MIT AND (MIT OR Unlicense)",
        "version": "0.1.8-1",
        "architecture": "x86_64",
        "license_class": "free",
        "homepage": "https://github.com/peios/netd"
    },
    "dependencies": {
        "dev.peios.libpeios": ">= 0.5.0",
        "org.gnu.glibc": "*",
        "org.gnu.gcc-libgcc": "*"
    },
    "files": {
        "source:LICENSE": "usr/share/licenses/dev.peios.netd/LICENSE",
        "stage:licenses/netd/**": "usr/share/licenses/dev.peios.netd/third-party",
        "stage:usr/sbin/netd": "usr/sbin/netd",
        "stage:usr/share/regim/netd-service.reg": "usr/share/regim/netd-service.reg",
        "stage:usr/share/regim/netd-default-profile.reg": "usr/share/regim/netd-default-profile.reg",
        "stage:usr/share/regman/netd.regman": "usr/share/regman/netd.regman",
        "source:docs/netd.evman": "usr/share/evman/netd.evman",
        "stage:usr/share/man/man8/netd.8.gz": "usr/share/man/man8/netd.8.gz",
        "stage:var/state/netd": "var/state/netd"
    },
    "sd_overrides": {
        "var/state/netd": "O:SYG:SYD:P(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)"
    },
    "executables": ["usr/sbin/netd"]
}
