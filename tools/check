#!/bin/sh
# Validate maintained sources, generated ABI inputs, tests and the complete package family.
set -eu
repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
if [ -n "${PEIOS_STYLE_BIN:-}" ]; then
    PATH="$PEIOS_STYLE_BIN:$PATH"
    export PATH
fi
python3 tools/style-check.py
python3 tools/update-kernel-inputs.py check
python3 tools/generate-netd-abi.py --check
./bazel test //...
./bazel build //:build-format-check //:packages //:api-docs

# Cargo supplies additional lint and documentation-example diagnostics.
: "${PEIOS_SDK:?Set PEIOS_SDK to an explicit development SDK}"
client_sdk=$(mktemp -d "${TMPDIR:-/tmp}/netd-check-sdk.XXXXXXXX")
trap 'rm -rf -- "$client_sdk"' EXIT HUP INT TERM
cp bazel-bin/libnetd/libnetd_ffi.so "$client_sdk/libnetd.so.1"
ln -s libnetd.so.1 "$client_sdk/libnetd.so"
export PEIOS_NETD_LIB_DIR="$client_sdk"
export PEIOS_LIB_DIR="$PEIOS_SDK/lib"
export PEIOS_INCLUDE="$PEIOS_SDK/include"
export PKM_UAPI="$PEIOS_SDK/include"
export LD_LIBRARY_PATH="$client_sdk:$PEIOS_LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
gcc_include=$(gcc -print-file-name=include)
export BINDGEN_EXTRA_CLANG_ARGS="-isystem $gcc_include${BINDGEN_EXTRA_CLANG_ARGS:+ $BINDGEN_EXTRA_CLANG_ARGS}"
cargo +1.98.1 clippy --workspace --exclude pnp-core --exclude peios-uapi --all-targets --no-deps --locked -- -D warnings
cargo +1.98.1 test --workspace --exclude pnp-core --exclude peios-uapi --doc --locked
