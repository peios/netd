#!/bin/bash
# Build an explicit Linux development SDK from caller-selected source revisions.
set -euo pipefail
libpeios_source=$(realpath "${1:?libpeios source directory required}")
uapi=$(realpath "${2:?kernel UAPI directory required}")
output=$(realpath -m "${3:?SDK output directory required}")
if [[ -e "$output" ]]; then
    echo "Use a new output directory so SDK versions cannot be mixed." >&2
    exit 1
fi
[[ -f "$libpeios_source/Cargo.lock" && -f "$uapi/pkm/access.h" ]]
mkdir -p "$output/include" "$output/lib"
# Build the pinned legacy SDK source selected by CI. netd itself uses Bazel.
cargo +1.98.1 build --locked --manifest-path "$libpeios_source/Cargo.toml" \
    --target-dir "$output/build"
readelf -d "$output/build/debug/libpeios.so" | grep -F '[libpeios.so.0]' >/dev/null
cp -a "$libpeios_source/include/." "$output/include/"
cp -a "$uapi/pkm" "$output/include/"
install -m 755 "$output/build/debug/libpeios.so" "$output/lib/libpeios.so.0"
ln -s libpeios.so.0 "$output/lib/libpeios.so"
sha256sum "$output/lib/libpeios.so.0" >"$output/library.sha256"
printf 'Development SDK: %s\n' "$output"
