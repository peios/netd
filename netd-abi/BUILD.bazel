load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "netd-abi",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:Cargo.toml",
        "//:Cargo.lock",
    ],
    crate_name = "netd_abi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = [] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":netd-abi",
)
