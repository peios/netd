load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:checks.bzl", "shared_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ),
)

rust_binary(
    name = "net",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:Cargo.toml",
        "//:Cargo.lock",
    ],
    crate_name = "net",
    crate_root = "src/main.rs",
    edition = "2024",
    version = VERSION,
    deps = ["//netd-client"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests-binary",
    size = "small",
    crate = ":net",
    tags = ["manual"],
)

shared_test(
    name = "tests",
    size = "small",
    binary = ":tests-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libnetd:soname",
    ],
)
