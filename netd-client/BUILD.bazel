load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")
load("//build:checks.bzl", "shared_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ) + ["build.rs"],
)

rust_library(
    name = "netd-client",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:Cargo.toml",
        "//:Cargo.lock",
    ],
    crate_name = "netd_client",
    crate_root = "src/lib.rs",
    edition = "2024",
    link_deps = ["//libnetd:link"],
    version = VERSION,
    deps = [
        "//netd-abi",
        "//netd-core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests-binary",
    size = "small",
    crate = ":netd-client",
    tags = ["manual"],
)

shared_test(
    name = "tests",
    size = "small",
    binary = ":tests-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libnetd:soname",
    ],
)

rust_test(
    name = "shared-binary",
    size = "small",
    srcs = ["tests/shared.rs"],
    crate_root = "tests/shared.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":netd-client",
        "//netd-abi",
        "//netd-core",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

shared_test(
    name = "shared",
    size = "small",
    binary = ":shared-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libnetd:soname",
    ],
)

rust_doc(
    name = "api-docs",
    crate = ":netd-client",
    rustdoc_flags = ["-Dwarnings"],
)
