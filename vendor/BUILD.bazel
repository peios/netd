load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["kernel/**"]),
)

rust_library(
    name = "peios-uapi",
    srcs = glob(["kernel/peios/rust/peios-uapi/*.rs"]) + ["kernel/security/pkm/kacs/peios_uapi.rs"],
    crate_name = "peios_uapi",
    crate_root = "kernel/peios/rust/peios-uapi/lib.rs",
    edition = "2024",
)

rust_test(
    name = "uapi-tests",
    size = "small",
    crate = ":peios-uapi",
)

rust_library(
    name = "pnp-core",
    srcs = ["kernel/peios/rust/pnp-core/lib.rs"] + glob(["kernel/security/pkm/pnp_core/**/*.rs"]),
    crate_name = "pnp_core",
    crate_root = "kernel/peios/rust/pnp-core/lib.rs",
    edition = "2021",
    deps = [":peios-uapi"],
)

rust_test(
    name = "pnp-tests",
    size = "small",
    crate = ":pnp-core",
)

